<Window x:Class="Reminders.ReminderDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Reminder" Width="320" SizeToContent="Height"
        ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner" Topmost="True">
    <StackPanel Margin="16">
        <Label Content="Date" Target="{Binding ElementName=ReminderDate}" Padding="0,0,0,4" />
        <DatePicker x:Name="ReminderDate" />
        <Label Content="Local time (24-hour HH:mm)" Target="{Binding ElementName=ReminderTime}"
               Padding="0,12,0,4" />
        <TextBox x:Name="ReminderTime" Padding="4" MaxLength="5" />
        <TextBlock x:Name="ValidationMessage" Foreground="Firebrick"
                   TextWrapping="Wrap" Margin="0,8,0,0" />
        <WrapPanel HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Clear" Padding="10,4" Margin="0,0,8,0" Click="Clear_Click" />
            <Button Content="Cancel" Padding="10,4" Margin="0,0,8,0" IsCancel="True" />
            <Button Content="Save" Padding="10,4" IsDefault="True" Click="Save_Click" />
        </WrapPanel>
    </StackPanel>
</Window>
