{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main, floating, Coach and Takeover windows",
  "windows": ["main", "float", "coach", "takeover"],
  "permissions": [
    "core:default",
    "core:window:allow-start-dragging",
    "core:window:allow-set-effects",
    "autostart:default",
    "updater:default",
    "process:allow-restart"
  ]
}
